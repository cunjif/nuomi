{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nuomi",
  "version": "0.1.0",
  "identifier": "dev.nuomi.shell",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "nuomi · 糯米",
        "width": 1400,
        "height": 900,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
