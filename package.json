{
  "name": "nuomi-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "contracts:gen": "cargo run -p nuomi-shell --bin contracts_gen",
    "contracts:check": "cargo run -p nuomi-shell --bin contracts_gen && git diff --exit-code -- src/lib/ipc",
    "coverage:rust": "cargo llvm-cov --workspace --summary-only",
    "coverage:rust:html": "cargo llvm-cov --workspace --html --output-dir target/llvm-cov"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "i18next": "^26.4.0",
    "marked": "^18.0.11",
    "monaco-editor": "^0.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.12",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.9.0",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.3.5",
    "vitest": "^2.0.5"
  }
}
